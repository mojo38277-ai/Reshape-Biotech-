  { id: "res-b-cereus", result: { name: "Bacillus cereus (probable)", description: "Large GP rods, spore+, motile, beta-hemolytic", features: ["Large GP rods", "Spore +", "Motile", "Beta-hemolytic"], notes: "Food poisoning." } },
  { id: "res-l-monocytogenes", result: { name: "Listeria monocytogenes (probable)", description: "GP short rods, catalase+, tumbling motility", features: ["GP short rods", "Catalase +", "Tumbling motility"], notes: "Grows at 4°C." } },
  { id: "res-corynebacterium", result: { name: "Corynebacterium spp. (probable)", description: "Pleomorphic GP rods, catalase+, non-motile", features: ["Pleomorphic GP rods", "Catalase +", "Non-motile"], notes: "Diphtheroids common." } },
  { id: "res-erysipelothrix", result: { name: "Erysipelothrix rhusiopathiae (probable)", description: "Slender GP rods, catalase-, H₂S+", features: ["Slender GP rods", "Catalase -", "H₂S +"], notes: "Zoonotic." } },
  { id: "res-neisseria", result: { name: "Neisseria spp. (probable)", description: "GN diplococci, oxidase+", features: ["GN diplococci", "Oxidase +"], notes: "Fastidious." } },
  { id: "res-veillonella", result: { name: "Veillonella spp. (probable)", description: "GN cocci, oxidase-", features: ["GN cocci", "Oxidase -"], notes: "Anaerobic." } },
  { id: "res-e-coli", result: { name: "Escherichia coli (probable)", description: "GN rods, LF, Indole+, motile", features: ["GN rods", "LF", "Indole +", "Motile"], notes: "IMViC + + - - ." } },
  { id: "res-k-pneumoniae", result: { name: "Klebsiella pneumoniae (probable)", description: "GN rods, mucoid LF, non-motile", features: ["GN rods", "Mucoid LF", "Non-motile"], notes: "IMViC - - + + ." } },
  { id: "res-enterobacter", result: { name: "Enterobacter spp. (probable)", description: "GN rods, LF, motile", features: ["GN rods", "LF", "Motile"], notes: "IMViC - - + + ." } },
  { id: "res-p-aeruginosa", result: { name: "Pseudomonas aeruginosa (probable)", description: "GN rods, NLF, oxidase+", features: ["GN rods", "NLF", "Oxidase +", "Pigment"], notes: "Grape-like odor." } },
  { id: "res-salmonella", result: { name: "Salmonella spp. (probable)", description: "GN rods, NLF, H₂S+, motile", features: ["GN rods", "NLF", "H₂S +", "Motile"], notes: "Serotyping needed." } },
  { id: "res-shigella", result: { name: "Shigella spp. (probable)", description: "GN rods, NLF, H₂S-, non-motile", features: ["GN rods", "NLF", "H₂S -", "Non-motile"], notes: "Highly infectious." } },
  { id: "res-proteus", result: { name: "Proteus spp. (probable)", description: "GN rods, NLF, H₂S+, swarming", features: ["GN rods", "NLF", "Swarming", "H₂S +", "Urease +"], notes: "PDA +." } }
];

const questionText = document.getElementById("question-text");
const optionsContainer = document.getElementById("options");
const helperText = document.getElementById("helper-text");
const pathList = document.getElementById("path-list");
const progressFill = document.getElementById("progress-fill");
const questionArea = document.getElementById("question-area");
const resultArea = document.getElementById("result-area");
const resultName = document.getElementById("result-name");
const resultDescription = document.getElementById("result-description");
const resultFeatures = document.getElementById("result-features");
const resultNotes = document.getElementById("result-notes");
const backBtn = document.getElementById("back-btn");
const resetBtn = document.getElementById("reset-btn");
const restartBtn = document.getElementById("restart-btn");

let history = [];

function getNodeById(id) {
  return treeData.find((n) => n.id === id) || null;
}

function renderPath() {
  pathList.innerHTML = "";
  history.forEach((item, idx) => {
    const chip = document.createElement("div");
    chip.className = "path-chip";
    chip.innerHTML = `<span class="step">Step ${idx + 1}</span> · <span class="label">${item.questionLabel || ""}</span> → <span class="answer">${item.choiceLabel}</span>`;
    pathList.appendChild(chip);
  });
  backBtn.disabled = history.length === 0;
  updateProgress();
}

function updateProgress() {
  const pct = Math.min(100, (history.length / 6) * 100);
  progressFill.style.width = pct + "%";
}

function startTree() {
  history = [];
  showQuestion("start");
  renderPath();
  resultArea.hidden = true;
  questionArea.hidden = false;
}

function showQuestion(nodeId) {
  const node = getNodeById(nodeId);
  if (!node) return;
  questionText.textContent = node.question;
  helperText.textContent = node.helper || "";
  optionsContainer.innerHTML = "";
  node.options.forEach((opt) => {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "option-btn";
    btn.innerHTML = `<span class="option-title">${opt.title}</span><span class="option-desc">${opt.description}</span>`;
    btn.addEventListener("click", () => {
      history.push({ nodeId: node.id, questionLabel: node.question, choiceLabel: opt.title, choiceValue: opt.value });
      renderPath();
      const nextId = typeof node.next === "function" ? node.next(opt.value) : node.next;
      const nextNode = getNodeById(nextId);
      if (nextNode && nextNode.result) {
        showResult(nextId);
      } else if (nextId) {
        showQuestion(nextId);
      } else {
        showResult(nextId);
      }
    });
    optionsContainer.appendChild(btn);
  });
}

function showResult(nodeId) {
  const node = getNodeById(nodeId);
  questionArea.hidden = true;
  resultArea.hidden = false;
  if (!node || !node.result) {
    resultName.textContent = "Identification Incomplete";
    resultDescription.textContent = "Could not determine a specific result from the current path.";
    resultFeatures.innerHTML = "";
    resultNotes.textContent = "Use 'Back' or 'Reset' to revise.";
    return;
  }
  const res = node.result;
  resultName.textContent = res.name;
  resultDescription.textContent = res.description;
  resultFeatures.innerHTML = "";
  (res.features || []).forEach((f) => {
    const li = document.createElement("li");
    li.textContent = f;
    resultFeatures.appendChild(li);
  });
  resultNotes.textContent = res.notes || "";
  window.scrollTo({ top: 0, behavior: "smooth" });
}

backBtn.addEventListener("click", () => {
  if (history.length === 0) return;
  history.pop();
  renderPath();
  resultArea.hidden = true;
  questionArea.hidden = false;
  if (history.length === 0) {
    startTree();
    return;
  }
  const last = history[history.length - 1];
  showQuestion(last.nodeId);
});

resetBtn.addEventListener("click", startTree);
restartBtn.addEventListener("click", startTree);

startTree();
