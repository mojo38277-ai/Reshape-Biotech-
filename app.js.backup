  ]
};

function getTestValues() {
  return {
    gram: document.getElementById("gram").value,
    morph: document.getElementById("morph").value,
    hemolysis: document.getElementById("hemolysis").value,
    spores: document.getElementById("spores").value,
    catalase: document.getElementById("catalase").value,
    oxidase: document.getElementById("oxidase").value,
    coagulase: document.getElementById("coagulase").value,
    urease: document.getElementById("urease").value,
    pyr: document.getElementById("pyr").value,
    optochin: document.getElementById("optochin").value,
    bacitracin: document.getElementById("bacitracin").value,
    mac: document.getElementById("mac").value,
    indole: document.getElementById("indole").value,
    mr: document.getElementById("mr").value,
    vp: document.getElementById("vp").value,
    citrate: document.getElementById("citrate").value,
    h2s: document.getElementById("h2s").value,
    motility: document.getElementById("motility").value,
    bileesculin: document.getElementById("bileesculin").value,
    nacl: document.getElementById("nacl").value,
    pda: document.getElementById("pda").value
  };
}

function scoreMatch(bacteria, tests) {
  let score = 0;
  let total = 0;
  let conflicts = 0;

  const check = (field, expected) => {
    if (!tests[field]) return;
    total += 1;
    if (Array.isArray(expected)) {
      if (expected.includes(tests[field])) score += 1;
      else conflicts += 1;
    } else if (tests[field] === expected) {
      score += 1;
    } else {
      conflicts += 1;
    }
  };

  check("gram", bacteria.gram);
  if (tests.morph && bacteria.morph) {
    total += 1;
    if (bacteria.morph.includes(tests.morph)) score += 1;
    else conflicts += 1;
  }
  check("hemolysis", bacteria.hemolysis);
  check("spores", bacteria.spores);
  check("catalase", bacteria.catalase);
  check("oxidase", bacteria.oxidase);
  check("coagulase", bacteria.coagulase);
  check("urease", bacteria.urease);
  check("pyr", bacteria.pyr);
  check("optochin", bacteria.optochin);
  check("bacitracin", bacteria.bacitracin);
  check("mac", bacteria.mac);
  check("indole", bacteria.indole);
  check("mr", bacteria.mr);
  check("vp", bacteria.vp);
  check("citrate", bacteria.citrate);
  check("h2s", bacteria.h2s);
  check("motility", bacteria.motility);
  check("bileesculin", bacteria.bileesculin);
  check("nacl", bacteria.nacl);
  check("pda", bacteria.pda);

  if (total === 0) return { score: 0, percent: 0, conflicts };
  const percent = Math.round((score / total) * 100);
  return { score, total, percent, conflicts };
}

function identifyBacteria() {
  const tests = getTestValues();
  const results = bacteriaDb
    .map((b) => {
      const s = scoreMatch(b, tests);
      return { ...b, ...s };
    })
    .filter((r) => r.total > 0)
    .sort((a, b) => {
      if (b.percent !== a.percent) return b.percent - a.percent;
      return b.score - a.score;
    });

  const matchesList = document.getElementById("matches-list");
  const matchResults = document.getElementById("match-results");
  const nextTestsSection = document.getElementById("next-tests-section");
  const nextTestsList = document.getElementById("next-tests-list");

  matchesList.innerHTML = "";
  nextTestsList.innerHTML = "";

  if (results.length === 0) {
    const div = document.createElement("div");
    div.className = "match-item";
    div.innerHTML = `<div class="match-info"><div class="match-name">No matches found</div><div class="match-features">Enter at least one test result to get suggestions.</div></div>`;
    matchesList.appendChild(div);
    matchResults.hidden = false;
    nextTestsSection.hidden = true;
    matchResults.scrollIntoView({ behavior: "smooth", block: "nearest" });
    return;
  }

  results.slice(0, 6).forEach((r, idx) => {
    const div = document.createElement("div");
    div.className = "match-item" + (idx === 0 ? " top-match" : "");
    div.innerHTML = `
      <div class="match-info">
        <div class="match-header-row">
          <div class="match-name">${r.name}</div>
          <div class="match-score">${r.percent}% match</div>
        </div>
        <div class="match-features">${r.features.slice(0, 4).join(" • ")}</div>
        <div class="match-notes">${r.notes}</div>
      </div>
    `;
    matchesList.appendChild(div);
  });

  // Suggest next tests
  const suggestions = new Set();
  const top = results[0];
  if (top.gram === "gp" && top.name.includes("Staphylococcus")) {
    nextTestSuggestions.s_aureus_vs_cons.forEach((s) => suggestions.add(s.test + " - " + s.reason));
  }
  if (top.gram === "gp" && (top.name.includes("Streptococcus") || top.name.includes("Enterococcus"))) {
    nextTestSuggestions.strep_group.forEach((s) => suggestions.add(s.test + " - " + s.reason));
  }
  if (top.gram === "gn" && top.mac === "lf") {
    nextTestSuggestions.enterics_lf.forEach((s) => suggestions.add(s.test + " - " + s.reason));
  }
  if (top.gram === "gn" && top.mac === "nlf") {
    nextTestSuggestions.enterics_nlf.forEach((s) => suggestions.add(s.test + " - " + s.reason));
  }
  if (top.gram === "gp" && top.name.includes("Bacillus") || top.name.includes("Listeria") || top.name.includes("Corynebacterium") || top.name.includes("Erysipelothrix")) {
    nextTestSuggestions.gp_rods.forEach((s) => suggestions.add(s.test + " - " + s.reason));
  }

  if (suggestions.size > 0) {
    suggestions.forEach((s) => {
      const li = document.createElement("li");
      li.textContent = s;
      nextTestsList.appendChild(li);
    });
    nextTestsSection.hidden = false;
  } else {
    nextTestsSection.hidden = true;
  }

  matchResults.hidden = false;
  matchResults.scrollIntoView({ behavior: "smooth", block: "nearest" });
}

document.getElementById("identify-btn").addEventListener("click", identifyBacteria);

document.getElementById("clear-tests-btn").addEventListener("click", () => {
  const selects = document.querySelectorAll("#results-card select");
  selects.forEach((s) => {
    s.value = "";
  });
  document.getElementById("match-results").hidden = true;
});

// Mode switching
const modeBtns = document.querySelectorAll(".mode-btn");
modeBtns.forEach((btn) => {
  btn.addEventListener("click", () => {
    modeBtns.forEach((b) => b.classList.remove("active"));
    btn.classList.add("active");
    const mode = btn.dataset.mode;
    if (mode === "results") {
      document.getElementById("results-card").hidden = false;
      document.getElementById("tree-card").hidden = true;
    } else {
      document.getElementById("results-card").hidden = true;
      document.getElementById("tree-card").hidden = false;
    }
  });
});

