/* Reset and base styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #0f1026;
    --card: #15182b;
    --panel: #1c1f3a;
    --text-primary: #f8fafc;
    --text-secondary: #cbd5f5;
    --accent: #38bdf8;
    --accent-strong: #0ea5e9;
    --success: #22c55e;
    --warning: #f59e0b;
    --border: rgba(148, 163, 184, 0.25);
    --highlight: rgba(56, 189, 248, 0.18);
}

body {
    font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background: radial-gradient(circle at top, #1d2147, var(--bg));
    color: var(--text-primary);
    line-height: 1.6;
    min-height: 100vh;
}

.app-header {
    padding: 2rem 1.5rem 1rem;
    text-align: center;
}

.header-content h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
}

.subtitle {
    color: var(--text-secondary);
    font-size: clamp(0.95rem, 2vw, 1.1rem);
}

.mode-nav {
    display: flex;
    justify-content: center;
    gap: 1rem;
    padding: 0 1.5rem 1.5rem;
    flex-wrap: wrap;
}

.mode-btn {
    appearance: none;
    background: var(--panel);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 0.7rem 1.8rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 150ms ease;
}

.mode-btn:hover {
    color: var(--text-primary);
    border-color: rgba(56, 189, 248, 0.6);
}

.mode-btn.active {
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-strong) 100%);
    color: #0b1026;
    border-color: transparent;
}

.app-container {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
    gap: 1.5rem;
    padding: 0 1.5rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
}

.card {
    background: linear-gradient(180deg, rgba(56, 189, 248, 0.08) 0%, var(--card) 100%);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 40px 60px -40px rgba(14, 165, 233, 0.45);
    backdrop-filter: blur(8px);
    overflow: hidden;
}

.card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.75rem 0.5rem;
    gap: 1rem;
}

.card-header h2 {
    font-size: 1.25rem;
    font-weight: 600;
}

.card-subtitle {
    color: var(--text-secondary);
    padding: 0 1.75rem 1rem;
    font-size: 0.95rem;
}

.header-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.ghost-btn {
    appearance: none;
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid transparent;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 150ms ease;
}

.ghost-btn:hover:not(:disabled) {
    color: var(--text-primary);
    background: rgba(148, 163, 184, 0.12);
}

.ghost-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.primary-btn {
    align-self: flex-start;
    appearance: none;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-strong) 100%);
    color: #0b1026;
    border: none;
    border-radius: 999px;
    padding: 0.7rem 1.6rem;
    font-weight: 600;
    font-size: 0.98rem;
    cursor: pointer;
    transition: transform 150ms ease, box-shadow 150ms ease;
}

.primary-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 25px 50px -30px rgba(14, 165, 233, 0.9);
}

.test-sections {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 0 1.75rem 1.5rem;
}

.test-section {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
}

.test-section h3 {
    margin-bottom: 1rem;
    font-size: 1.05rem;
    font-weight: 600;
}

.test-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
}

.test-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.test-item label {
    color: var(--text-secondary);
    font-size: 0.92rem;
}

.test-item select {
    appearance: none;
    background: var(--card);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.6rem 0.9rem;
    font-size: 0.95rem;
}

.results-panel {
    margin: 0 1.75rem 2rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.match-header h3 {
    font-size: 1.1rem;
    font-weight: 600;
}

.match-subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
}

.matches-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
}

.match-item {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
}

.match-item.top-match {
    border-color: rgba(34, 197, 94, 0.7);
    box-shadow: 0 20px 40px -30px rgba(34, 197, 94, 0.8);
}

.match-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.match-name {
    font-weight: 600;
    font-size: 1.05rem;
}

.match-score {
    color: var(--success);
    font-weight: 600;
}

.match-features {
    color: var(--text-secondary);
    font-size: 0.95rem;
}

.match-notes {
    color: var(--text-secondary);
    font-size: 0.95rem;
}

.next-tests {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
}

.next-tests h4 {
    font-weight: 600;
}

.next-tests-subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
}

.next-tests ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--text-secondary);
    padding-left: 1.2rem;
}

.disclaimer {
    color: var(--text-secondary);
    font-size: 0.95rem;
    background: rgba(245, 158, 11, 0.16);
    border: 1px solid rgba(245, 158, 11, 0.5);
    border-radius: 12px;
    padding: 1rem 1.25rem;
}

.progress-bar {
    height: 4px;
    margin: 0 1.75rem 1rem;
    background: rgba(148, 163, 184, 0.2);
    border-radius: 999px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-strong) 100%);
    width: 0%;
    transition: width 200ms ease;
}

.path-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0 1.75rem 1rem;
    min-height: 2.5rem;
}

.path-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--panel);
    border: 1px solid var(--border);
    font-size: 0.95rem;
    color: var(--text-secondary);
}

.path-chip .label {
    color: var(--text-primary);
    font-weight: 500;
}

.path-chip .answer {
    color: var(--accent);
    font-weight: 600;
}

.question-area {
    padding: 1rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.question-area h3 {
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-weight: 600;
}

.options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
}

.option-btn {
    appearance: none;
    background: var(--panel);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    cursor: pointer;
    transition: all 160ms ease;
}

.option-btn:hover {
    border-color: rgba(56, 189, 248, 0.8);
    box-shadow: 0 20px 40px -30px rgba(56, 189, 248, 0.9);
    transform: translateY(-2px);
}

.option-btn .option-title {
    font-size: 1.05rem;
    font-weight: 600;
}

.option-btn .option-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
}

.helper-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
}

.result-area {
    padding: 1rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.result-header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
}

.result-badge {
    align-self: flex-start;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: rgba(34, 197, 94, 0.2);
    color: var(--success);
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.result-area h3 {
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 700;
}

.result-description {
    color: var(--text-secondary);
    font-size: 1rem;
}

.result-details,
.result-notes {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
}

.result-details h4,
.result-notes h4 {
    font-weight: 600;
}

.result-details ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.7rem 1.5rem;
    color: var(--text-secondary);
    padding-left: 1.2rem;
}

.result-notes p {
    color: var(--text-secondary);
}

.side-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.side-panel .card {
    background: linear-gradient(180deg, rgba(148, 163, 184, 0.08) 0%, var(--card) 100%);
}

.guide-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 0 1.75rem 1.75rem;
    color: var(--text-secondary);
    list-style: none;
}

.guide-list li::before {
    content: '•';
    color: var(--accent);
    margin-right: 0.6rem;
}

.test-definitions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0 1.75rem 1.75rem;
}

.test-definitions dt {
    font-weight: 600;
    margin-bottom: 0.25rem;
}

.test-definitions dd {
    color: var(--text-secondary);
    font-size: 0.98rem;
}

.app-footer {
    text-align: center;
    padding: 0 1.5rem 2rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
}

@media (max-width: 1180px) {
    .app-container {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 640px) {
    .card-header {
        flex-direction: column;
        align-items: flex-start;
    }
    .options {
        grid-template-columns: 1fr;
    }
    .result-details ul {
        grid-template-columns: 1fr;
    }
    .test-grid {
        grid-template-columns: 1fr;
    }
}
